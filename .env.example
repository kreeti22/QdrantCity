# ============================================================================
# QdrantCinema Edge Platform — Environment Configuration Example
# ============================================================================
# Copy this file to .env and adjust values for your environment.
# ALL variables are optional — sensible defaults are used when unset.
#
# Variable prefix: QDRANT_EDGE_
# ============================================================================

# ----------------------------------------------------------------------------
# Application Identity
# ----------------------------------------------------------------------------
QDRANT_EDGE_APP_NAME="QdrantCinema Edge Platform"
QDRANT_EDGE_APP_VERSION="0.6.0"
QDRANT_EDGE_ENVIRONMENT="development"  # development | staging | production
QDRANT_EDGE_DEBUG="false"

# ----------------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------------
QDRANT_EDGE_HOST="0.0.0.0"
QDRANT_EDGE_PORT="8000"

# CORS — comma-separated origins or JSON array.
# Use * only for development. In production, list explicit origins.
QDRANT_EDGE_CORS_ORIGINS="*"
# Example for production:
# QDRANT_EDGE_CORS_ORIGINS='["https://your-domain.com"]'

# ----------------------------------------------------------------------------
# Logging (Phase 3B)
# ----------------------------------------------------------------------------
QDRANT_EDGE_LOG_LEVEL="INFO"   # DEBUG | INFO | WARNING | ERROR | CRITICAL
QDRANT_EDGE_LOG_FORMAT="text"  # text | json (json for structured log aggregation)

# ----------------------------------------------------------------------------
# Storage Paths
# ----------------------------------------------------------------------------
QDRANT_EDGE_EDGE_STORAGE_PATH="data/edge"
QDRANT_EDGE_COLLECTION_NAME="city_experiences"
QDRANT_EDGE_USER_MEMORY_PATH="data/memory/user_memory.db"
QDRANT_EDGE_SYNC_CHECKPOINT_PATH="data/sync/sync_checkpoint.json"

# ----------------------------------------------------------------------------
# Seed Data
# ----------------------------------------------------------------------------
QDRANT_EDGE_SEED_DATA_PATH="data/seed/experiences.json"
QDRANT_EDGE_AUTO_SEED_ON_STARTUP="true"

# ----------------------------------------------------------------------------
# Embedding Model (fully local — no API key needed)
# ----------------------------------------------------------------------------
QDRANT_EDGE_EMBEDDING_MODEL_NAME="BAAI/bge-small-en-v1.5"
QDRANT_EDGE_EMBEDDING_DIMENSION="384"
QDRANT_EDGE_VECTOR_SIZE="384"
QDRANT_EDGE_VECTOR_DISTANCE="Cosine"
# Optional: set a custom cache dir for FastEmbed model weights
# QDRANT_EDGE_EMBEDDING_CACHE_DIR="/path/to/model/cache"

# ----------------------------------------------------------------------------
# Hybrid Retrieval
# ----------------------------------------------------------------------------
QDRANT_EDGE_RRF_K="60"
QDRANT_EDGE_DENSE_TOP_K="20"
QDRANT_EDGE_BM25_TOP_K="20"
QDRANT_EDGE_FINAL_TOP_K="10"
QDRANT_EDGE_MAX_QUERY_LENGTH="500"

# ----------------------------------------------------------------------------
# Personalization & User Memory
# ----------------------------------------------------------------------------
QDRANT_EDGE_ENABLE_PERSONALIZATION="true"
QDRANT_EDGE_PERSONALIZATION_BOOST_WEIGHT="0.20"   # 0.0–1.0
QDRANT_EDGE_DEFAULT_USER_ID="local-default"

# ----------------------------------------------------------------------------
# Query Understanding
# ----------------------------------------------------------------------------
QDRANT_EDGE_ENABLE_QUERY_UNDERSTANDING="true"
QDRANT_EDGE_REFERENCE_DATETIME="2026-10-15T12:00:00Z"
QDRANT_EDGE_TIMEZONE="UTC"
QDRANT_EDGE_DEFAULT_CURRENCY="USD"

# ----------------------------------------------------------------------------
# Edge-to-Server Synchronization (Phase 2D — disabled by default)
# ----------------------------------------------------------------------------
QDRANT_EDGE_SYNC_ENABLED="false"
# Set this to the URL of your central catalog server when sync is enabled:
# QDRANT_EDGE_SYNC_SERVER_URL="https://catalog.example.com"
QDRANT_EDGE_SYNC_INTERVAL_SECONDS="3600"   # minimum 30
QDRANT_EDGE_SYNC_TIMEOUT_SECONDS="10.0"
QDRANT_EDGE_SYNC_BATCH_SIZE="50"           # 1–1000
QDRANT_EDGE_SYNC_MAX_ITEMS_PER_RUN="500"
# API key for sync server (keep this secret — never commit to source control):
# QDRANT_EDGE_SYNC_API_KEY="your-secret-key-here"

# ----------------------------------------------------------------------------
# Rate Limiting (Phase 3C — disabled by default)
# Enables lightweight in-process sliding-window protection on expensive endpoints.
# ----------------------------------------------------------------------------
QDRANT_EDGE_RATE_LIMIT_SEARCH_ENABLED="false"
QDRANT_EDGE_RATE_LIMIT_SEARCH_REQUESTS="60"         # requests per window
QDRANT_EDGE_RATE_LIMIT_SEARCH_WINDOW_SECONDS="60.0"

QDRANT_EDGE_RATE_LIMIT_SYNC_ENABLED="false"
QDRANT_EDGE_RATE_LIMIT_SYNC_REQUESTS="10"
QDRANT_EDGE_RATE_LIMIT_SYNC_WINDOW_SECONDS="60.0"
